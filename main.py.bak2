"""
Mini Control Center
--------------------
A prototype Windows control panel that lets you:
  - See every app currently playing audio and control its volume/mute individually
  - Watch live CPU usage + temp, RAM usage, and GPU usage + temp

WINDOWS ONLY. Relies on:
  - WASAPI (via pycaw/comtypes) for per-app audio
  - psutil for CPU/RAM usage
  - pynvml for GPU usage/VRAM (NVIDIA only)
  - LibreHardwareMonitor's WMI interface for CPU temp + GPU temp (any vendor)

Install dependencies:
    pip install PyQt6 pycaw comtypes psutil pynvml wmi

Also required for temps:
    Download LibreHardwareMonitor (https://github.com/LibreHardwareMonitor/LibreHardwareMonitor),
    run LibreHardwareMonitor.exe AS ADMINISTRATOR, and leave it running in the background.
    It exposes a WMI namespace (root\\LibreHardwareMonitor) that this app reads from.
    If it's not running, CPU/GPU temp will just show "N/A".

Run:
    python main.py
"""

import sys
import os
import json
import psutil

from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QSlider, QPushButton, QScrollArea, QFrame, QTabWidget,
    QProgressBar, QCheckBox, QGraphicsDropShadowEffect, QSizePolicy
)
from PyQt6.QtCore import Qt, QTimer, QRectF
from PyQt6.QtGui import QPainter, QPen, QColor, QFont, QConicalGradient, QFontMetrics

HIDDEN_SESSIONS_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hidden_sessions.json")

from pycaw.pycaw import AudioUtilities

try:
    import pynvml
    pynvml.nvmlInit()
    NVML_AVAILABLE = True
except Exception:
    NVML_AVAILABLE = False


